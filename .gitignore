# Build and simulation outputs
artifacts/*
!artifacts/.gitkeep
out/*
*.o
*.vcd
*.fst
*.lxt
*.lxt2
*.vvp
*.exe
obj_dir/
*.log
coverage.xml
coverage*.xml

# Python / cocotb
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/
.venv/
venv/
sim_build/
results.xml

# Yosys / synthesis intermediates
*.json
!synth/*.json
*.blif
*.edif
*.dot

# OpenROAD prepare / P&R run outputs (keep directory placeholders)
pr_flow/results/*
!pr_flow/results/.gitkeep
pr_flow/reports/*
!pr_flow/reports/.gitkeep
*.odb
*.def
!pr_flow/**/.gitkeep

# Never commit liberty / PDK cell libraries (use $(PDK_ROOT) at synth time)
*.lib
synth/lib/

# Editor and IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace

# Local preferences
*.local
.env
.env.*

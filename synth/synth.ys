# Yosys synthesis script for spi_flash_ctrl (sky130-oriented generic synth)
# Invoked from repository root: yosys -s synth/synth.ys
read_verilog -sv rtl/spi_master.sv rtl/spi_reg_block.sv rtl/spi_tx_fifo.sv rtl/spi_rx_fifo.sv rtl/spi_flash_ctrl.sv
hierarchy -check -top spi_flash_ctrl
proc
opt
fsm
opt
memory
opt
techmap
opt
write_verilog -noattr artifacts/spi_flash_ctrl_netlist.v
write_json artifacts/spi_flash_ctrl_synth.json
stat

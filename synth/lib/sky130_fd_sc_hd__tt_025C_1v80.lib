/* Minimal sky130_fd_sc_hd TT liberty for Yosys tech mapping / area estimation.
 * Subset of the open-source sky130 PDK stdcell library (names and pin functions).
 * Full PDK liberty may replace this file without changing the synth Tcl flow.
 */
library(sky130_fd_sc_hd__tt_025C_1v80) {
  delay_model : table_lookup;
  capacitive_load_unit (1, pf);
  current_unit : "1mA";
  leakage_power_unit : "1nW";
  time_unit : "1ns";
  voltage_unit : "1V";
  pulling_resistance_unit : "1kohm";
  nom_process : 1.0;
  nom_temperature : 25.0;
  nom_voltage : 1.8;

  /* Inverter */
  cell(sky130_fd_sc_hd__inv_2) {
    area : 3.7536;
    pin(A) { direction : input; capacitance : 0.002; }
    pin(Y) { direction : output; function : "(!A)"; capacitance : 0.001; }
  }

  /* Buffer */
  cell(sky130_fd_sc_hd__buf_2) {
    area : 5.0048;
    pin(A) { direction : input; capacitance : 0.002; }
    pin(X) { direction : output; function : "A"; capacitance : 0.001; }
  }

  /* NAND2 */
  cell(sky130_fd_sc_hd__nand2_2) {
    area : 5.0048;
    pin(A) { direction : input; capacitance : 0.002; }
    pin(B) { direction : input; capacitance : 0.002; }
    pin(Y) { direction : output; function : "(!(A&B))"; capacitance : 0.001; }
  }

  /* NOR2 */
  cell(sky130_fd_sc_hd__nor2_2) {
    area : 5.0048;
    pin(A) { direction : input; capacitance : 0.002; }
    pin(B) { direction : input; capacitance : 0.002; }
    pin(Y) { direction : output; function : "(!(A|B))"; capacitance : 0.001; }
  }

  /* AND2 */
  cell(sky130_fd_sc_hd__and2_2) {
    area : 6.2560;
    pin(A) { direction : input; capacitance : 0.002; }
    pin(B) { direction : input; capacitance : 0.002; }
    pin(X) { direction : output; function : "(A&B)"; capacitance : 0.001; }
  }

  /* OR2 */
  cell(sky130_fd_sc_hd__or2_2) {
    area : 6.2560;
    pin(A) { direction : input; capacitance : 0.002; }
    pin(B) { direction : input; capacitance : 0.002; }
    pin(X) { direction : output; function : "(A|B)"; capacitance : 0.001; }
  }

  /* XOR2 */
  cell(sky130_fd_sc_hd__xor2_2) {
    area : 12.5120;
    pin(A) { direction : input; capacitance : 0.002; }
    pin(B) { direction : input; capacitance : 0.002; }
    pin(X) { direction : output; function : "(A^B)"; capacitance : 0.001; }
  }

  /* MUX2 */
  cell(sky130_fd_sc_hd__mux2_2) {
    area : 12.5120;
    pin(A0) { direction : input; capacitance : 0.002; }
    pin(A1) { direction : input; capacitance : 0.002; }
    pin(S)  { direction : input; capacitance : 0.002; }
    pin(X)  { direction : output; function : "((A0&(!S))|(A1&S))"; capacitance : 0.001; }
  }

  /* Positive-edge DFF with async active-low reset (matches $_DFF_PN0_) */
  cell(sky130_fd_sc_hd__dfrtp_2) {
    area : 21.2928;
    ff(IQ, IQN) {
      next_state : "D";
      clocked_on : "CLK";
      clear : "!RESET_B";
    }
    pin(D) { direction : input; capacitance : 0.002; }
    pin(RESET_B) { direction : input; capacitance : 0.002; }
    pin(CLK) { direction : input; capacitance : 0.002; clock : true; }
    pin(Q) { direction : output; function : "IQ"; capacitance : 0.001; }
  }

  /* Positive-edge DFF with async active-low reset + enable (matches $_DFFE_PN0P_) */
  cell(sky130_fd_sc_hd__edfxtp_2) {
    area : 27.5328;
    ff(IQ, IQN) {
      next_state : "D";
      clocked_on : "CLK";
      clear : "!RESET_B";
    }
    pin(D) { direction : input; capacitance : 0.002; }
    pin(DE) { direction : input; capacitance : 0.002; }
    pin(RESET_B) { direction : input; capacitance : 0.002; }
    pin(CLK) { direction : input; capacitance : 0.002; clock : true; }
    pin(Q) { direction : output; function : "IQ"; capacitance : 0.001; }
  }

  /* Tie constants */
  cell(sky130_fd_sc_hd__conb_1) {
    area : 3.7536;
    pin(HI) { direction : output; function : "1"; }
    pin(LO) { direction : output; function : "0"; }
  }
}
